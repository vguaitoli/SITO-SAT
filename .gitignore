#env
.env
.env.*
!.env.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vite
.vercel
# Si escludono i contenuti, non la cartella: Git non entra in una directory
# esclusa e la riammissione dei comandi non avrebbe effetto.
.claude/*
!.claude/commands/
graphify-out

# Generati da TinaCMS durante dev/build
public/admin/
tina/__generated__/

# Config MCP locale (tooling, non parte del sito)
.mcp.json

# Config di altri strumenti locali
.codex/

# Archivio fotografico di lavoro: centinaia di MB di originali da cui si
# ricavano le immagini ottimizzate in public/media. Non va nel repository.
foto per sito/

# ---- Social Studio: materiale privato ----
# Le tracce GPX sono un asset dell'attività e non devono finire nel
# repository, né nel bundle, né sotto public/. Social Studio le tiene in
# IndexedDB, quindi normalmente non toccano il disco del progetto: questa
# regola serve contro il file lasciato lì per sbaglio.
*.gpx
# Cartella di lavoro per materiale che non deve essere versionato
# (esportazioni, backup dello studio, foto originali in lavorazione).
privato/
